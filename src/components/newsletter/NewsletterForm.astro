---

<form class="newsletter-form" action="/api/newsletter/subscribe" method="post">
  <label for="newsletter-email" class="sr-only">Email address</label>
  <input
    type="email"
    id="newsletter-email"
    name="email"
    placeholder="you@example.com"
    autocomplete="email"
    required
  >
  <button type="submit">Subscribe</button>
</form>