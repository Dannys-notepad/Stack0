---
interface Props {
  title: string;
}

const { title } = Astro.props;
const url = Astro.url.href;
const xUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
---

<div class="share-row">
  <span class="share-label">Share</span>
  <a href={xUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22H16.9l-5-6.6-5.7 6.6H2.1l8.1-9.3L1.5 2h6.6l4.5 6.1L18.9 2Zm-1.1 18h1.7L7.3 3.9H5.5L17.8 20Z"/></svg>
  </a>
  <button
    class="share-copy"
    type="button"
    data-copy-url={url}
    aria-label="Copy link"
    title="Copy link"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"/><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5"/></svg>
  </button>
</div>