---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Temporarily unavailable"
  description="The site is down for maintenance. Try again shortly."
  showNewsletter={false}
>
  <main class="error-main">
    <div class="error-glyph-wrap">
      <svg class="error-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28">
        <path d="M12 9v4"/>
        <path d="M12 17h.01"/>
        <circle cx="12" cy="12" r="10"/>
      </svg>
    </div>

    <span class="status-indicator">
      <span class="status-dot"></span>
      <span>Maintenance in progress</span>
    </span>

    <h1 class="error-code" style="font-size: 3.5rem;">503</h1>
    <h2 class="error-title">We'll be back shortly</h2>
    <p class="error-desc">
      The site is temporarily offline for maintenance. Retrying automatically in
      <strong id="retryCount">60s</strong>.
    </p>

    <div class="retry-bar" aria-hidden="true">
      <div class="retry-bar-fill" id="retryBarFill"></div>
    </div>

    <div class="error-actions">
      <button class="error-btn primary" id="retryNowBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12a9 9 0 1 1-3-6.7"/>
          <path d="M21 3v6h-6"/>
        </svg>
        Retry now
      </button>
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/retry.js';
</script>