---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BackLink from '../components/common/BackLink.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import site from '../data/site.json';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return b.data.startDate.valueOf() - a.data.startDate.valueOf();
  });
---

<BaseLayout title="About" description={`About ${site.author} — Backend developer and third-year Industrial Chemistry student.`}>
  <BackLink href="/" label="Back to all posts" />

  <main>
    <section class="about-intro">
      <img class="about-avatar" src="/assets/img/me.jpg" width="96" height="96" alt="Profile photo">
      <div>
        <h1 class="about-name">{site.author}</h1>
        <p class="about-role">Backend developer · third-year Industrial Chemistry student</p>
        <div class="social-links">
          <a href={`mailto:${site.social.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 6l10 7 10-7"/></svg>
          </a>
          <a href={site.social.x} aria-label="X" title="X">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22H16.9l-5-6.6-5.7 6.6H2.1l8.1-9.3L1.5 2h6.6l4.5 6.1L18.9 2Zm-1.1 18h1.7L7.3 3.9H5.5L17.8 20Z"/></svg>
          </a>
          <a href={site.social.github} aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.6.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.4.1-2.8 0 0 .8-.3 2.7 1a9 9 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.5.1 2.8.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7 1 .7 2v3c0 .3.2.6.7.5 3.9-1.3 6.8-5.1 6.8-9.6C22 6.6 17.5 2 12 2Z"/></svg>
          </a>
          <a href={site.social.rss} aria-label="RSS" title="RSS">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/></svg>
          </a>
        </div>
      </div>
    </section>

    <div class="prose about-bio">
      <p>I'm a self-taught backend developer and a third-year Industrial Chemistry student. </p>
      <p> I write about backend work, project escapades, and my debugging process.</p>
    </div>

    <h2 class="section-title">Projects</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard
          href={`/projects/${project.id}`}
          title={project.data.title}
          desc={project.data.description}
          stack={project.data.stack}
          status={project.data.status}
          openSource={project.data.openSource}
        />
      ))}
    </div>

    <p style="margin-top: 1.5rem;">
      <a class="back-link" href="/projects">See all projects →</a>
    </p>

    <h2 class="section-title">Skills &amp; tools</h2>

    <div class="skills-group">
      <div class="skills-group-label">Languages</div>
      <div class="skills-pills">
        <span>JavaScript</span><span>TypeScript</span><span>Go (Learning)</span>
      </div>
    </div>

    <div class="skills-group">
      <div class="skills-group-label">Frameworks</div>
      <div class="skills-pills">
        <span>Express</span><span>Hono</span>
      </div>
    </div>

    <div class="skills-group">
      <div class="skills-group-label">Infra &amp; data</div>
      <div class="skills-pills">
        <span>Postgres</span><span>Firebase</span>
      </div>
    </div>

    <h2 class="section-title">Get in touch</h2>
    <div class="prose">
      <p> I'm comfortable in JavaScript, but never limited to it, I learn what the project needs, and I learn it fast. </p>
      <p>Open to backend roles, freelance work, and interesting conversations. The fastest way to reach me is <a href={`mailto:${site.social.email}`}>email</a>, or you can find me on <a href={site.social.x}>X</a> and <a href={site.social.github}>GitHub</a>.</p>
    </div>
  </main>
</BaseLayout>